{
    "manifest_version": 3,

    "name": "RED//CORE",
    "version": "1.0.0",

    "description": "A cyber-themed productivity dashboard.",

    "permissions": [
        "storage",
        "geolocation"
    ],

    "host_permissions": [
        "https://api.open-meteo.com/*"
    ],
    "icons": {
    "16": "assets/chrome16.png",
    "32": "assets/chrome32.png",
    "192": "assets/chrome192.png",
    "512": "assets/chrome512.png"
},

    "chrome_url_overrides": {
        "newtab": "newtab/newtab.html"
    },

    "action": {
        "default_title": "RED//CORE"
    }
}